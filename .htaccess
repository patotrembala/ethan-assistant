Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# Mantém links antigos funcionando e usa /assistance-ia como endereço oficial.
# O redirecionamento 307 preserva método e dados de formulários POST antigos.
RewriteRule ^ethan-ia/?$ /assistance-ia [R=307,L,NE]
RewriteRule ^ethan-ia/(.+)$ /assistance-ia/$1 [R=307,L,NE]

RewriteRule ^(?:config|database|docs|scripts|src|storage|tests)(?:/|$) - [F,L,NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

<FilesMatch "^\.(env|git|ht)">
  Require all denied
</FilesMatch>
